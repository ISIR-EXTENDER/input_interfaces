<?xml version="1.0"?>
<package format="3">
  <name>keyboard_interface</name>
  <version>0.0.0</version>
  <description>Publishes configured keyboard key states to ROS 2 Boolean topics.</description>
  <maintainer email="etienne.moullet@gmail.com">Etienne Moullet</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-pynput</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
