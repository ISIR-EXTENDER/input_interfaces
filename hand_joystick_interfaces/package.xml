<?xml version="1.0"?>
<package format="3">
  <name>hand_joystick_interfaces</name>
  <version>0.0.0</version>
  <description>Normalized 2D/3D hand joystick input for joystick_mapper</description>
  <maintainer email="etienne.moullet@gmail.com">emoullet</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>eigen</depend>
  <depend>signal_processing</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>joystick_mapper</exec_depend>
  <exec_depend>mediapipe_mocap</exec_depend>
  <exec_depend>offline_media_publisher</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>usb_cam</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
