<?xml version="1.0"?>
<package format="3">
  <name>mouse_joystick_interface</name>
  <version>0.0.0</version>
  <description>2D mouse joystick web interface publishing teleop commands</description>
  <maintainer email="etienne.moullet@gmail.com">emoullet</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>extender_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
